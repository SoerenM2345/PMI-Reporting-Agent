# Copy to .env to enable real LLM calls.
#
# WITHOUT A KEY the agent still runs end to end: extraction, standardization,
# conflict detection, resolution and file generation are all deterministic Python.
# What you lose is the semantic layer — executive summaries become template prose,
# request parsing falls back to keyword matching, and images cannot be interpreted
# at all (see IMAGE EXTRACTION below). Every fallback is recorded in the run's
# data-quality report, so a keyless run is honest about what it could not do.

# ---------------------------------------------------------------- provider
# anthropic | openai | none
LLM_PROVIDER=openai

OPENAI_API_KEY=..
#ANTHROPIC_API_KEY=

# ------------------------------------------------------------------ models
# Model IDs are configuration, never hard-coded (spec §21.10).
LLM_MODEL=gpt-4o
VISION_MODEL=gpt-4o
FAST_MODEL=gpt-4o-mini

# LLM_MAX_TOKENS=4096
# LLM_EFFORT=medium          # low | medium | high
# LLM_THINKING=false         # adaptive thinking for the harder semantic tasks
# LLM_TIMEOUT_S=90
# LLM_MAX_RETRIES=2

# --------------------------------------------------------------- conflicts
# A = ask the user about every conflict
# B = always auto-resolve by source priority
# C = hybrid: auto-resolve low/medium, ask on high/critical  (spec's recommendation)
CONFLICT_MODE=C

# ------------------------------------------------------------ data quality
# Findings below this confidence are flagged for human review (§5.6).
# LOW_CONFIDENCE_THRESHOLD=0.6
# IMAGE_MAX_EDGE_PX=1568
# UPLOAD_MAX_MB=25

# --------------------------------------------------- IMAGE EXTRACTION (§5.6)
# Reading a risk heatmap, a whiteboard photo or a screenshot of a tracker needs a
# vision-capable model. With no key, the agent reports that it could not interpret
# the image — it does not guess. Optionally install local OCR as a weaker fallback:
#   pip install -r requirements-ocr.txt && brew install tesseract
